SHELL=/bin/bash

# Copy from snellius scratch shared
0 3 * * * bash /data2/yujiehe/rich-monitor/scripts/backup_snellius_scratch.sh

# Backup the home folder
0 4 * * * bash /data2/yujiehe/rich-monitor/scripts/backup_snellius_home.sh

# Run diagnostiscs on the latest snapshot
0 5 * * * bash /data2/yujiehe/rich-monitor/scripts/run_dispatch.sh /disks/emrdata/YujieSnellius/R0.47M0.5BH100000beta1S60n1.5ComptonHiResNewAMR/ /data1/yujiehe/snellius-logs/R0.47M0.5BH100000beta1S60n1.5ComptonHiResNewAMR/
0 6 * * * bash /data2/yujiehe/rich-monitor/scripts/run_dispatch.sh /disks/emrdata/YujieSnellius/R0.47M0.5BH10000beta1S60n1.5ComptonHiResNewAMR/ /data1/yujiehe/snellius-logs/R0.47M0.5BH10000beta1S60n1.5ComptonHiResNewAMR/

# Do progress monitor
0 7 * * * bash /data2/yujiehe/rich-monitor/scripts/run_monitor.sh /disks/emrdata/YujieSnellius/ /data1/yujiehe/snellius-logs/

# Copy to Google drive
0 8 * * * bash /data2/yujiehe/rich-monitor/scripts/upload_logs_gdrive.sh


